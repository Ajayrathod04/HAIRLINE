# Copy to .env. Never commit real secrets.
HL_SECRET_KEY=change-me-to-a-long-random-string
HL_AUTH_MODE=demo            # demo | cognito
HL_SEED_DEMO=1               # create SIMULATED demo cases on first boot
HL_STORE=sqlite              # sqlite | dynamodb
HL_SQLITE_PATH=data/hairline.db
HL_BLOB_BACKEND=local        # local | s3
HL_BLOB_DIR=data/blobs
# --- AWS (used by infra/template.yaml user-data) ---
AWS_REGION=ap-south-1
HL_S3_BUCKET=
HL_DYNAMO_TABLE=
HL_PLANNER=rules             # rules | bedrock
HL_BEDROCK_MODEL_ID=         # copy from your Bedrock console; UNVERIFIED which models your account can use
HL_COGNITO_REGION=
HL_COGNITO_POOL_ID=
HL_COGNITO_CLIENT_ID=
HL_MARKER_MM=50
